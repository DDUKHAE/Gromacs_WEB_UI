; ions.mdp - tpr for genion
integrator               = steep
emtol                    = 1000.0
emstep                   = 0.01
nsteps                   = 50000
nstlist                  = 1
cutoff-scheme            = Verlet
coulombtype              = {coulombtype}
rcoulomb                 = {rcoulomb}
rvdw                     = {rvdw}
pbc                      = xyz
